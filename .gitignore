.env
venv/
__pycache__/
*.pyc
/data/
/logs/
.pytest_cache/
.vscode/
.idea/
.claude/

# Observability stack secrets (ADR-0001 Phase 3) — never in git
deploy/compose/.env
deploy/compose/alertmanager/secrets/*
!deploy/compose/alertmanager/secrets/README.md

# Research data lake — raw + derived are regenerable; calendar is tracked
research/data/raw/
research/data/derived/

# Forward evidence SQLite DB — data, not code; backed up separately
research/data/forward_evidence.db
research/data/forward_evidence.db-wal
research/data/forward_evidence.db-shm

# ivrv/H5/G1/G3 forward evidence collector DB — live runtime data, backed up separately
research/data/evidence_forward.db
research/data/evidence_forward.db-wal
research/data/evidence_forward.db-shm

# Decision-time feature rows + execution-outcome labels — live runtime data,
# relocated here from research/{feature_store,label_store}/ so the production
# systemd sandbox (ProtectSystem=strict) can write them. NOT the governed
# feature_store.db / label_store.db, which stay ignored above.
research/data/decision_features.db
research/data/decision_features.db-wal
research/data/decision_features.db-shm
research/data/decision_outcomes.db
research/data/decision_outcomes.db-wal
research/data/decision_outcomes.db-shm

# Empty placeholder committed at wrong path in 1639dfb — not a live file
research/data/ledger.db

# Governance ledger — append-only runtime data, backed up separately
# registry.yaml in the same directory IS tracked (it is code, not data)
research/evidence_library/ledger.db
research/evidence_library/ledger.db-wal
research/evidence_library/ledger.db-shm
research/evidence_library/ledger.pre-*.db
# Superseded local governance chain retired by GL-2, retained permanently as
# the historical archive holding the ORIGINAL dataset.seal receipt. Immutable,
# never pruned; off-host custody under BK3. See
# docs/governance/gl3_ledger_reconciliation_record.md §2.
research/evidence_library/ledger.superseded-local.*.db*

# Feature Store registry/value-store DB — data populated by
# migrate_evidence_engine_features.py, not code
research/feature_store/feature_store.db
research/feature_store/feature_store.db-wal
research/feature_store/feature_store.db-shm
research/feature_store/feature_store.pre-*.db

# Label Store registry/value-store DB — data, not code (Phase 3 WBS 3.1/3.2)
research/label_store/label_store.db
research/label_store/label_store.db-wal
research/label_store/label_store.db-shm
research/label_store/label_store.pre-*.db

# Dataset Builder registry DB — data, not code (Phase 4 WBS 4.1, DS-DEC-005)
research/dataset_builder/dataset_builder.db
research/dataset_builder/dataset_builder.db-wal
research/dataset_builder/dataset_builder.db-shm
research/dataset_builder/dataset_builder.pre-*.db

# Build/run launchers and logs at repo root
run_*.bat
corpus_build*.log
corpus_build*.err*
perp_build*.log
perp_build*.err*
h4_build*.log
h4_build*.err*
h5_build*.log
h5_build*.err*
h1_build*.log
h1_build*.err*
h6_build*.log
h6_build*.err*
h6_validation*.log
h6_validation*.err*

# Corpus summaries, hypothesis reports, smoke-test artifacts — all regenerable.
#
# Written as `dir/*` rather than `dir/` so a single file can be re-included
# below: git never descends into an excluded *directory*, so a `!` rule inside
# one has no effect.
research/reports/*
!research/reports/evidence_library/
research/reports/evidence_library/*

# ...except the published lockbox validation record, which is NOT regenerable:
# reproducing it means re-running run_lockbox_validation.py, which opens the
# sealed lockbox (2025-06-01..2026-05-31). That is the final pre-promotion OOS
# test and spending it is irreversible.
#
# It is also load-bearing for two checks: WBS 4.6's RF2 governed source is
# validated against it (`test_governed_source_matches_published_record`), and
# BASELINE_46.json pins it. Both are unverifiable on a fresh clone or in CI
# while the file is ignored.
!research/reports/evidence_library/lockbox_validation.json