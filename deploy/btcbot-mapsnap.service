[Unit]
Description=BTC Bot daily instrument id->symbol map snapshot (one-shot)
After=network.target

[Service]
Type=oneshot
User=btcbot
Group=btcbot
WorkingDirectory=/opt/btcbot
ExecStart=/opt/btcbot/venv/bin/python scripts/snapshot_instrument_map.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btcbot-mapsnap
