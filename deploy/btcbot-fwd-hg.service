[Unit]
Description=BTC Forward Evidence — H5, G1, G3 daily collection (one-shot)
Documentation=file:/opt/btcbot/deploy/install.md
After=network-online.target time-sync.target
Wants=network-online.target
# Escalate a non-zero exit immediately. The Gate 5C.26 outage was 19 daily
# status=1/FAILURE exits with a healthy timer -- systemd knew every time, and
# nothing asked it. Deliberately NOT Restart=: run_daily aborts fail-closed on
# a governance pre-check failure and re-running would either fail identically
# or write evidence against a registry already judged invalid.
OnFailure=btcbot-alert@%n.service

[Service]
Type=oneshot
User=btcbot
Group=btcbot
WorkingDirectory=/opt/btcbot/research
ExecStart=/opt/miniconda3/envs/btc_bot/bin/python -m forward_evidence.run_daily
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=btcbot-fwd-hg
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# evidence_library is required by the DEPLOYED unit (host, since
# 2026-06-27) and was missing here -- repo drift, not an intentional
# tightening. run_daily invokes evidence_library/report.py --check, and
# although 18 consecutive daily runs left ledger.db untouched (mtime
# 2026-08-07, the migration), SQLite may still require write access to
# OPEN a database. Removing the path is unproven and would risk the
# Gate 5C.26 failure class, so the deployed grant is preserved.
ReadWritePaths=/opt/btcbot/data /opt/btcbot/research/data /opt/btcbot/research/evidence_library

[Install]
WantedBy=multi-user.target
