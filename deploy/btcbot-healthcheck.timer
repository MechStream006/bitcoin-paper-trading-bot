[Unit]
Description=BTC Bot health check every 10 minutes
Documentation=file:/opt/btcbot/docs/runbook.md
Requires=btcbot-healthcheck.service

[Timer]
# Every 10 minutes, on the 10-minute mark
OnCalendar=*:0/10
# Small random spread to avoid thundering-herd with other timers
RandomizedDelaySec=30
# Don't catch up on missed runs (health check is a point-in-time read)
Persistent=false

[Install]
WantedBy=timers.target
