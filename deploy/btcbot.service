[Unit]
Description=BTC Paper Trading Bot
Documentation=file:/opt/btcbot/docs/runbook.md
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=btcbot
Group=btcbot
WorkingDirectory=/opt/btcbot

# Activate venv by calling its Python directly
ExecStart=/opt/btcbot/venv/bin/python -m src.main

# Prevent Python from writing .pyc files — ProtectSystem=strict makes the
# source tree read-only and .pyc write failures would otherwise generate noise.
Environment=PYTHONDONTWRITEBYTECODE=1

# Restart unconditionally; 10s cooldown prevents restart storms
Restart=always
RestartSec=10

# Give the bot 30s to drain (main.py handles SIGTERM → drain() → clean exit)
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=btcbot

# Non-root hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# data/ must be writable (DB, logs, backups).
# research/data must ALSO be writable even though this process only ever
# reads evidence_forward.db (via alerts.forward_status, mode=ro): that DB is
# WAL-journaled, and a WAL reader must open/lock the -wal/-shm sibling files,
# which requires write access to the containing directory regardless of the
# SQL-level mode. Without this, summarize() fails with sqlite3.OperationalError:
# "unable to open database file" even though the file, its permissions, and
# summarize() itself are all fine in isolation.
ReadWritePaths=/opt/btcbot/data /opt/btcbot/research/data

[Install]
WantedBy=multi-user.target
