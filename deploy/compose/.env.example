# Compose-level secrets for the observability stack (ADR-0001 §9 S3).
# Copy to deploy/compose/.env (gitignored) and fill in a real value.
# This is intentionally separate from the bot's own /opt/btcbot/.env.

# Grafana admin password, set on first boot. Rotate it immediately after
# first login (S3) -- this value only sets the INITIAL password.
GRAFANA_ADMIN_PASSWORD=change_me_on_first_login
