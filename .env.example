# Delta Exchange (testnet)
DELTA_API_KEY=your_testnet_api_key
DELTA_API_SECRET=your_testnet_api_secret
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL=wss://socket-ind.testnet.deltaex.org

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=-1001234567890

# Runtime
ENV=dev
LOG_LEVEL=INFO
DB_PATH=data/btc_trading.db

# Off-host backup (ADR-0001 BK3) — see docs/ops/offhost-backup.md
# Shell template; {file} and {manifest} are substituted. Empty = local-only.
# With --encrypt these resolve to the CIPHERTEXT and its .age-manifest.json.
BACKUP_OFFHOST_CMD=
# age PUBLIC recipient key. The host encrypts only; it can never decrypt.
# NEVER put an AGE-SECRET-KEY-... private identity here — the private key must
# not exist on the production host. The code rejects it if you try.
BACKUP_AGE_RECIPIENT=
